#!/usr/bin/env bash
set -euo pipefail

code_command="$(command -v code || command -v code-insiders || true)"
if [ -z "$code_command" ] || ! "$code_command" --version >/dev/null 2>&1; then
  echo "VS Code CLI not found; skipping extension installation."
  exit 0
fi

if [ -n "$code_command" ]; then
  {{- range $extensions }}
  "$code_command" --force --install-extension {{ . }}
  {{- end }}
fi
